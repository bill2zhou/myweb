# 依赖与构建产物（体积大且可重新安装/重新生成）
node_modules/
dist/

# 编辑器/IDE 数据
.codebuddy/
.vs/
.vscode/

# 运行期产生的文件
data/
log/
*.log

# 原始生产数据（含真实设备/人员记录），不进版本库；
# 需要时在新机器上通过「数据库管理 → 导入」单独导入这份 SQL。
localhost.sql

# 数据库与缩略图缓存
*.db
*.db-wal
*.db-shm
.seeded
Thumbs.db

# 系统文件
.DS_Store

# 「测试资料查询」同源转发代理的打包产物（由 search/web-proxy/build-exe.js 生成，约 88 MB）；
# 源码 proxy.js / build-exe.js 仍进版本库，需要 exe 时本机执行 node build-exe.js 即可
search/web-proxy/dist/
search/web-proxy/.cache/
